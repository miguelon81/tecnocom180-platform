generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// =====================
// ENUMS
// =====================

enum UserRole {
  SUPER_ADMIN
  ORG_ADMIN
  OPERATIONS
  RECEPTION
  TECHNICIAN
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  MAINTENANCE
  CLEANING
}

enum DeviceType {
  ROUTER
  SWITCH
  ACCESS_POINT
  CAMERA
  NVR
  UPS
  MODEM
  SERVER
  NAS
  IOT
  AGENT
  OTHER
}

enum TicketStatus {
  OPEN
  PENDING
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketType {
  WIFI
  INTERNET
  TV
  CAMERA
  NETWORK
  OTHER
}

enum TicketSource {
  QR_GUEST
  MANUAL
  API
  AUTOMATIC
}

enum DiagnosticStatus {
  RUNNING
  SUCCESS
  FAILED
}

enum GuestStayStatus {
  RESERVED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

enum GuestWifiStatus {
  PENDING
  ACTIVE
  EXPIRED
  DISABLED
}

// =====================
// ORGANIZATION
// =====================

model Organization {
  id String @id @default(uuid())

  name String

  slug String @unique

  phone String?

  email String?

  timezone String @default("America/Mexico_City")

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  users User[]

  sites Site[]

  tickets Ticket[]

  diagnostics DiagnosticRun[]
}

// =====================
// USERS
// =====================

model User {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  name String

  email String @unique

  passwordHash String

  phone String?

  role UserRole

  active Boolean @default(true)

  lastLogin DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  assignedTickets Ticket[]
  ticketComments  TicketComment[]
  sites           UserSite[]

  @@index([organizationId])
}

// =====================
// SITES
// =====================

model Site {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  name String

  code String

  address String?

  city String?

  state String?

  country String?

  active Boolean @default(true)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  areas Area[]

  rooms Room[]

  devices Device[]

  tickets Ticket[]

  guests Guest[]

  users UserSite[]

  diagnostics DiagnosticRun[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

// =====================
// USER SITES
// =====================

model UserSite {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  siteId String
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, siteId])
  @@index([userId])
  @@index([siteId])
}

// =====================
// AREAS
// =====================

model Area {
  id String @id @default(uuid())

  siteId String

  site Site @relation(fields: [siteId], references: [id])

  name String

  type String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  rooms Room[]

  devices Device[]

  tickets Ticket[]

  @@index([siteId])
}

// =====================
// ROOMS
// =====================

model Room {
  id String @id @default(uuid())

  siteId String

  site Site @relation(fields: [siteId], references: [id])

  areaId String?

  area Area? @relation(fields: [areaId], references: [id])

  number String

  floor Int?

  status RoomStatus @default(AVAILABLE)

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  tickets Ticket[]

  guestStays GuestStay[]

  @@unique([siteId, number])
  @@index([siteId])
}

// =====================
// GUESTS
// =====================

model Guest {
  id String @id @default(uuid())

  siteId String

  site Site @relation(fields: [siteId], references: [id])

  name String

  email String?

  phone String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  stays GuestStay[]

  @@index([siteId])
}

// =====================
// GUEST STAYS
// =====================

model GuestStay {
  id String @id @default(uuid())

  guestId String

  guest Guest @relation(fields: [guestId], references: [id])

  roomId String

  room Room @relation(fields: [roomId], references: [id])

  checkIn DateTime

  checkOut DateTime

  actualCheckIn DateTime?

  actualCheckOut DateTime?

  status GuestStayStatus @default(RESERVED)

  notes String?

  wifiMaxDevices Int @default(2)

  wifiAccess GuestWifiAccess?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([guestId])
  @@index([roomId])
  @@index([checkIn])
  @@index([checkOut])
  @@index([status])
}

// =====================
// GUEST WIFI ACCESS
// =====================

model GuestWifiAccess {
  id String @id @default(uuid())

  stayId String @unique

  stay GuestStay @relation(fields: [stayId], references: [id])

  username String?

  password String?

  accessUrl String?

  token String @unique

  status GuestWifiStatus @default(PENDING)

  maxDevices Int @default(2)

  activatedAt DateTime?

  expiresAt DateTime

  deactivatedAt DateTime?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([expiresAt])
}

// =====================
// BRAND
// =====================

model Brand {
  id String @id @default(uuid())

  name String @unique

  createdAt DateTime @default(now())

  models DeviceModel[]
}

// =====================
// DEVICE MODEL
// =====================

model DeviceModel {
  id String @id @default(uuid())

  brandId String

  brand Brand @relation(fields: [brandId], references: [id])

  name String

  type DeviceType

  codePrefix String?

  createdAt DateTime @default(now())

  devices Device[]

  @@unique([brandId, name])
  @@index([brandId])
}

// =====================
// DEVICES
// =====================

model Device {
  id String @id @default(uuid())

  deviceCode String? @unique

  siteId String

  site Site @relation(fields: [siteId], references: [id])

  areaId String?

  area Area? @relation(fields: [areaId], references: [id])

  modelId String

  model DeviceModel @relation(fields: [modelId], references: [id])

  name String?

  hostname String?

  serial String?

  ip String?

  mac String?

  firmware String?

  online Boolean @default(false)

  lastSeenAt DateTime?

  installedAt DateTime?

  notes String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  tickets Ticket[]

  telemetry DeviceTelemetry[]

  @@index([siteId])
  @@index([modelId])
}

// =====================
// TICKETS
// =====================

model Ticket {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  siteId String?

  site Site? @relation(fields: [siteId], references: [id])

  areaId String?

  area Area? @relation(fields: [areaId], references: [id])

  deviceId String?

  device Device? @relation(fields: [deviceId], references: [id])

  roomId String?

  room Room? @relation(fields: [roomId], references: [id])

  assignedToId String?

  assignedTo User? @relation(fields: [assignedToId], references: [id])

  type TicketType

  source TicketSource @default(MANUAL)

  status TicketStatus @default(OPEN)

  title String

  description String?

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  comments TicketComment[]

  @@index([organizationId])
  @@index([siteId])
  @@index([areaId])
  @@index([deviceId])
  @@index([roomId])
}

// =====================
// TICKET COMMENTS
// =====================

model TicketComment {
  id String @id @default(uuid())

  ticketId String

  ticket Ticket @relation(fields: [ticketId], references: [id])

  userId String

  user User @relation(fields: [userId], references: [id])

  comment String

  createdAt DateTime @default(now())

  @@index([ticketId])
  @@index([userId])
}

// =====================
// DIAGNOSTICS
// =====================

model DiagnosticRun {
  id String @id @default(uuid())

  organizationId String

  organization Organization @relation(fields: [organizationId], references: [id])

  // Nullable temporalmente para conservar diagnósticos históricos
  // que fueron creados antes del aislamiento por sitio.
  siteId String?

  site Site? @relation(fields: [siteId], references: [id])

  status DiagnosticStatus @default(RUNNING)

  startedAt DateTime @default(now())

  finishedAt DateTime?

  result DiagnosticResult?

  @@index([organizationId])
  @@index([siteId])
}

// =====================
// DIAGNOSTIC RESULTS
// =====================

model DiagnosticResult {
  id String @id @default(uuid())

  diagnosticRunId String @unique

  diagnosticRun DiagnosticRun @relation(fields: [diagnosticRunId], references: [id])

  pingMs       Float?
  downloadMbps Float?
  uploadMbps   Float?
  packetLoss   Float?
  gateway      String?
  dns          String?
  internet     Boolean?

  rawResult Json?
}

// =====================
// AUDIT LOG
// =====================

model AuditLog {
  id String @id @default(uuid())

  organizationId String

  userId String?

  action String

  entity String

  entityId String?

  data String?

  createdAt DateTime @default(now())

  @@index([organizationId])
}

// =====================
// DEVICE TELEMETRY
// =====================

model DeviceTelemetry {
  id String @id @default(uuid())

  deviceId String

  device Device @relation(fields: [deviceId], references: [id])

  nivel Float?

  bateria Float?

  senal Float?

  recarga Float?

  consumo Float?

  relay1 Int?

  createdAt DateTime @default(now())

  @@index([deviceId])
  @@index([createdAt])
}
